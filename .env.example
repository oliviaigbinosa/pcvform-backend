MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Pettycashvoucher?retryWrites=true&w=majority

# JWT secret for authentication (required)
JWT_SECRET=your-random-jwt-secret-min-32-characters

# Password reset token secret (used to sign reset links)
RESET_TOKEN_SECRET=your-random-reset-secret
FRONTEND_URL=http://localhost:3000
# When true, force the backend to accept requests from localhost regardless of FRONTEND_URL
FORCE_LOCALHOST=false

# SMTP email settings (used for sending all application emails)
# Provide your SMTP host, port, secure flag, username and password.
# Optionally set SMTP_FROM to override the From address used in emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-user@example.com

SUPER_ADMIN_EMAIL=your-super-admin-email
SUPER_ADMIN_PASSWORD=your-super-admin-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-user@example.com
PORT=3001
