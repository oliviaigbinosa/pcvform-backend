MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Pettycashvoucher?retryWrites=true&w=majority

# JWT secret for authentication (required)
JWT_SECRET=your-random-jwt-secret-min-32-characters

# Password reset token secret (used to sign reset links)
RESET_TOKEN_SECRET=your-random-reset-secret
FRONTEND_URL=https://pettycashvoucher.netlify.app

# Resend email (preferred when RESEND_API_KEY is set)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
TEST_RECIPIENT=your-resend-account@example.com

# Set to true after the getpayedmail.com domain is verified on Resend to send to real recipients
RESEND_DOMAIN_VERIFIED=false

SUPER_ADMIN_EMAIL=your-super-admin-email
SUPER_ADMIN_PASSWORD=your-super-admin-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-user@example.com
PORT=3001
